{
  "name": "flic-wiim-control",
  "version": "1.1.0",
  "private": true,
  "description": "WiiM speaker control and UPnP event integration for Flic Hub Studio",
  "flicHub": {
    "name": "wiim-control"
  },
  "scripts": {
    "build": "yarn typecheck && node scripts/build.mjs",
    "check": "yarn test && yarn build && node --check dist/main.js && node --check dist/main.debug.js",
    "test": "yarn typecheck && node scripts/test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    }
  },
  "packageManager": "yarn@4.18.1"
}
